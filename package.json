{
  "name": "campus-hiring-assessment",
  "version": "1.5.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node scripts/check-headers.mjs && vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "migrate:apply": "wrangler d1 migrations apply campus-hiring-assessment-db --remote",
    "migrate:list": "wrangler d1 migrations list campus-hiring-assessment-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply campus-hiring-assessment-db --local",
    "db:migrate:local:docs": "wrangler d1 migrations apply talo-docs-db --local --env docs",
    "typecheck": "tsc --noEmit",
    "dev:docs": "wrangler dev --env docs",
    "deploy:docs": "wrangler deploy --env docs",
    "migrate:docs": "wrangler d1 migrations apply talo-docs-db --remote --env docs",
    "test:limits": "vitest run -c vitest.limits.config.ts"
  },
  "dependencies": {
    "unpdf": "^0.12.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.30",
    "@cloudflare/workers-types": "^5.0.0",
    "@playwright/test": "^1.63.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.0.0"
  }
}
