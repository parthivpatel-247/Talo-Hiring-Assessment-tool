# Talo: secrets and local settings, with placeholder values only.
#
# Local development (`wrangler dev`) reads them from a git-ignored file:
#   support site:  cp .env.example .dev.vars
#   writers site:  cp .env.example .dev.vars.docs
# In production, set each secret with `npx wrangler secret put <NAME>`
# (add `--env docs` for the writers site). Never commit real values.
# Non-secret settings (question counts, durations, ADMIN_EMAIL, model name...)
# live in wrangler.toml under [vars] and [env.docs.vars].

# Required. OpenAI key used on the server only (resume parsing, grading,
# interview questions). Any placeholder works if you don't test the AI features.
OPENAI_API_KEY=sk-your-key-here

# Required. Signs candidate and admin session cookies: a long random string,
# e.g. `openssl rand -hex 32`. Use a different value in each environment.
SESSION_SECRET=replace-with-a-long-random-string

# Required. With ADMIN_EMAIL (wrangler.toml), creates the first manager account
# on first sign-in and remains its recovery password.
ADMIN_PASSWORD=choose-a-strong-password

# Optional (support site). With PANEL_EMAIL (wrangler.toml): a shared panel-member
# sign-in. Leave empty to give every panel member a named account instead.
PANEL_PASSWORD=

# Optional, local testing only: send OpenAI calls to a local stand-in server
# (https://host or a local http address). Leave unset in production, and unset
# when running `npm test` (the tests mock OpenAI themselves).
# OPENAI_BASE_URL=http://127.0.0.1:8799
