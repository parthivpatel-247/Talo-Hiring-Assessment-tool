# Copy to .dev.vars (git-ignored) for `npm run dev`. Local values only.
SESSION_SECRET=any-long-random-string-for-local-testing-only
# Only for creating the first manager account (with ADMIN_EMAIL from wrangler.toml).
ADMIN_PASSWORD=choose-a-local-setup-password
# Optional locally: resume reading and grading need a real key.
OPENAI_API_KEY=
# Optional: email (also set EMAIL_PROVIDER and EMAIL_FROM) and Turnstile.
EMAIL_API_KEY=
TURNSTILE_SECRET=
